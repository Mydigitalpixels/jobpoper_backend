# Server Configuration
PORT=3001
NODE_ENV=development

# Test OTP (000000) is enabled by default for any phone.
# Set to false to require real Twilio codes only:
# ALLOW_TEST_OTP=false

# MongoDB Configuration
MONGODB_URI=your-mongodb-connection-string

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Twilio Configuration
# OTP SMS brand text comes from Verify Service Friendly Name (or customFriendlyName in code).
# In Twilio Console → Verify → Services → set Friendly Name to "MakeMy Task" (recommended).
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_SERVICE_ID=your-twilio-verify-service-id
